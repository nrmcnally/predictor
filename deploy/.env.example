# Copy to deploy/.env and fill in. NEVER commit the filled-in file.

# Required — tokens are signed with this. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# Seeds the first admin account on boot (log in with these, then change the password).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to 0 once your friend group has accounts (admins can still reset passwords).
ALLOW_REGISTRATION=1
