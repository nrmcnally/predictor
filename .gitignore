# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Node / frontend
node_modules/
dist/
frontend/node_modules/
frontend/dist/

# Environment variables / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local generated reports
backend/data/reports/*.json

# Large/local generated data
backend/data/raw/*.csv
backend/data/processed/*.csv

# SQLite transactional data layer (WAL produces -wal / -shm sidecars)
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm

# Trained model files
backend/models/*.joblib
backend/models/*.json

# Optional placeholders if you create empty folders
!backend/data/raw/.gitkeep
!backend/data/processed/.gitkeep
!backend/data/reports/.gitkeep
!backend/models/.gitkeep
/backend/data/reports/method_label_exploration.csv
/backend/data/reports/method_label_summary.json
/start_app.bat
/start_app.local.bat

# Generated backend model artifacts
backend/models/
