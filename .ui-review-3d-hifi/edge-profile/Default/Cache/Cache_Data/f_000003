const __vite__css = "/* ============================================================\r\n   FIGHT IQ — design system\r\n   Dark, cinematic \"fight night\" theme.\r\n   Display: Barlow Condensed · Body: Inter · Numbers: JetBrains Mono\r\n   ============================================================ */\r\n\r\n:root {\r\n  --bg0: #05060a;\r\n  --bg1: #0a0c13;\r\n  --surface: #0e111a;\r\n  --surface2: #131726;\r\n  --line: rgba(146, 160, 214, 0.12);\r\n  --line-strong: rgba(146, 160, 214, 0.24);\r\n\r\n  --text: #eef1fa;\r\n  --dim: #9aa3bd;\r\n  --faint: #6b7390;\r\n\r\n  --red: #ff3355;\r\n  --red-soft: rgba(255, 51, 85, 0.13);\r\n  --blue: #3d7bff;\r\n  --blue-soft: rgba(61, 123, 255, 0.13);\r\n  --accent-gold: #f5c451;\r\n  --gold-soft: rgba(245, 196, 81, 0.12);\r\n  --green: #2fd58b;\r\n  --green-soft: rgba(47, 213, 139, 0.12);\r\n  --amber: #fba94c;\r\n  --amber-soft: rgba(251, 169, 76, 0.12);\r\n  --violet: #8b7cf6;\r\n  --violet-soft: rgba(139, 124, 246, 0.14);\r\n\r\n  --font-display: \"Barlow Condensed\", \"Arial Narrow\", sans-serif;\r\n  --font-body: \"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\r\n  --font-mono: \"JetBrains Mono\", ui-monospace, \"Cascadia Mono\", monospace;\r\n\r\n  --radius: 16px;\r\n  --radius-sm: 10px;\r\n  --shadow: 0 18px 50px rgba(0, 0, 0, 0.45);\r\n\r\n  color-scheme: dark;\r\n}\r\n\r\n* {\r\n  box-sizing: border-box;\r\n}\r\n\r\nhtml,\r\nbody {\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\nbody {\r\n  background:\r\n    radial-gradient(1100px 500px at 12% -10%, rgba(255, 51, 85, 0.07), transparent 60%),\r\n    radial-gradient(1100px 520px at 88% -12%, rgba(61, 123, 255, 0.08), transparent 60%),\r\n    var(--bg0);\r\n  color: var(--text);\r\n  font-family: var(--font-body);\r\n  font-size: 14.5px;\r\n  line-height: 1.55;\r\n  -webkit-font-smoothing: antialiased;\r\n}\r\n\r\n#root {\r\n  min-height: 100vh;\r\n}\r\n\r\nh1, h2, h3, h4 {\r\n  margin: 0;\r\n}\r\n\r\np {\r\n  margin: 0;\r\n}\r\n\r\n::selection {\r\n  background: rgba(255, 51, 85, 0.35);\r\n}\r\n\r\n::-webkit-scrollbar {\r\n  width: 10px;\r\n  height: 10px;\r\n}\r\n\r\n::-webkit-scrollbar-thumb {\r\n  background: #232a3f;\r\n  border-radius: 99px;\r\n  border: 2px solid var(--bg0);\r\n}\r\n\r\n::-webkit-scrollbar-track {\r\n  background: transparent;\r\n}\r\n\r\n/* ---------- shell ---------- */\r\n\r\n.app-shell {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 100vh;\r\n}\r\n\r\n.topbar {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 60;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  padding: 10px 20px;\r\n  background: rgba(6, 7, 12, 0.82);\r\n  backdrop-filter: blur(14px);\r\n  border-bottom: 1px solid var(--line);\r\n}\r\n\r\n.topbar-left {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n}\r\n\r\n.nav-toggle {\r\n  display: none;\r\n  background: none;\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--radius-sm);\r\n  color: var(--text);\r\n  font-size: 16px;\r\n  padding: 6px 10px;\r\n  cursor: pointer;\r\n}\r\n\r\n.brand-mark {\r\n  width: 36px;\r\n  height: 36px;\r\n  object-fit: contain;\r\n  filter: drop-shadow(0 0 12px rgba(255, 51, 85, 0.35));\r\n}\r\n\r\n.brand-copy {\r\n  display: flex;\r\n  flex-direction: column;\r\n  line-height: 1.1;\r\n}\r\n\r\n.brand-kicker {\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.22em;\r\n  text-transform: uppercase;\r\n  color: var(--faint);\r\n}\r\n\r\n.brand-name {\r\n  font-family: var(--font-display);\r\n  font-size: 24px;\r\n  font-weight: 900;\r\n  letter-spacing: 0.04em;\r\n}\r\n\r\n.brand-name em {\r\n  font-style: italic;\r\n  color: var(--red);\r\n}\r\n\r\n.topbar-right {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.mode-pill {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  padding: 5px 12px;\r\n  border-radius: 99px;\r\n  border: 1px solid var(--line);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  color: var(--dim);\r\n  background: var(--surface);\r\n}\r\n\r\n.mode-pill .status-dot {\r\n  width: 7px;\r\n  height: 7px;\r\n  border-radius: 50%;\r\n  background: var(--faint);\r\n}\r\n\r\n.mode-pill.online { color: var(--green); border-color: rgba(47, 213, 139, 0.35); }\r\n.mode-pill.online .status-dot { background: var(--green); box-shadow: 0 0 8px var(--green); }\r\n.mode-pill.offline { color: var(--red); border-color: rgba(255, 51, 85, 0.35); }\r\n.mode-pill.offline .status-dot { background: var(--red); }\r\n.mode-pill.mock { color: var(--accent-gold); border-color: rgba(245, 196, 81, 0.35); }\r\n\r\n.shell-body {\r\n  display: flex;\r\n  flex: 1;\r\n  min-height: 0;\r\n}\r\n\r\n/* ---------- sidebar ---------- */\r\n\r\n.sidebar {\r\n  position: sticky;\r\n  top: 57px;\r\n  align-self: flex-start;\r\n  width: 224px;\r\n  flex-shrink: 0;\r\n  height: calc(100vh - 57px);\r\n  overflow-y: auto;\r\n  padding: 18px 14px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 18px;\r\n  border-right: 1px solid var(--line);\r\n  background: linear-gradient(180deg, rgba(14, 17, 26, 0.6), rgba(8, 10, 16, 0.3));\r\n}\r\n\r\n.nav-group {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 3px;\r\n}\r\n\r\n.nav-group-label {\r\n  font-size: 10px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.22em;\r\n  text-transform: uppercase;\r\n  color: var(--faint);\r\n  padding: 0 10px 6px;\r\n}\r\n\r\n.nav-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 11px;\r\n  padding: 9px 11px;\r\n  border: none;\r\n  border-radius: var(--radius-sm);\r\n  background: transparent;\r\n  color: var(--dim);\r\n  font-family: var(--font-body);\r\n  font-size: 13.5px;\r\n  font-weight: 600;\r\n  text-align: left;\r\n  cursor: pointer;\r\n  transition: background 0.15s ease, color 0.15s ease;\r\n}\r\n\r\n.nav-item:hover {\r\n  background: var(--surface2);\r\n  color: var(--text);\r\n}\r\n\r\n.nav-item.active {\r\n  background: linear-gradient(90deg, var(--red-soft), transparent 85%);\r\n  color: var(--text);\r\n  box-shadow: inset 2px 0 0 var(--red);\r\n}\r\n\r\n.nav-icon {\r\n  width: 22px;\r\n  text-align: center;\r\n  font-size: 14px;\r\n  opacity: 0.85;\r\n}\r\n\r\n.sidebar-footer {\r\n  margin-top: auto;\r\n  padding: 12px;\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--radius);\r\n  background: var(--surface);\r\n  font-size: 11.5px;\r\n  color: var(--faint);\r\n  line-height: 1.5;\r\n}\r\n\r\n.nav-scrim {\r\n  display: none;\r\n}\r\n\r\n/* ---------- main ---------- */\r\n\r\n.main-content {\r\n  flex: 1;\r\n  min-width: 0;\r\n  padding: 26px 30px 70px;\r\n  max-width: 1460px;\r\n}\r\n\r\n.offline-banner {\r\n  margin-bottom: 18px;\r\n  padding: 12px 16px;\r\n  border: 1px solid rgba(255, 51, 85, 0.4);\r\n  border-radius: var(--radius);\r\n  background: var(--red-soft);\r\n  color: #ffb3c1;\r\n  font-size: 13px;\r\n}\r\n\r\n.offline-banner code {\r\n  font-family: var(--font-mono);\r\n  font-size: 12px;\r\n  color: var(--text);\r\n  background: rgba(0, 0, 0, 0.35);\r\n  padding: 1px 6px;\r\n  border-radius: 6px;\r\n}\r\n\r\n.view {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 18px;\r\n  animation: view-in 0.3s ease;\r\n}\r\n\r\n@keyframes view-in {\r\n  from { opacity: 0; transform: translateY(8px); }\r\n  to { opacity: 1; transform: none; }\r\n}\r\n\r\n.view-head {\r\n  display: flex;\r\n  align-items: flex-end;\r\n  justify-content: space-between;\r\n  gap: 18px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.view-title {\r\n  font-family: var(--font-display);\r\n  font-size: 42px;\r\n  font-weight: 900;\r\n  font-style: italic;\r\n  letter-spacing: 0.02em;\r\n  text-transform: uppercase;\r\n  line-height: 1;\r\n}\r\n\r\n.eyebrow {\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.24em;\r\n  text-transform: uppercase;\r\n  color: var(--red);\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.muted { color: var(--dim); }\r\n.mono { font-family: var(--font-mono); font-size: 0.95em; }\r\n.dim-note { color: var(--faint); font-size: 12.5px; line-height: 1.55; margin-top: 10px; }\r\n\r\n/* ---------- cards ---------- */\r\n\r\n.card {\r\n  background: linear-gradient(180deg, var(--surface), rgba(14, 17, 26, 0.6));\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--radius);\r\n  padding: 20px 22px;\r\n}\r\n\r\n.card-head {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.card-title {\n  font-family: var(--font-display);\n  font-size: 22px;\n  font-weight: 800;\n  text-transform: uppercase;\n  letter-spacing: 0;\n  line-height: 1.1;\n}\n\r\n.card-description {\r\n  color: var(--dim);\r\n  font-size: 12.5px;\r\n  margin-top: 6px;\r\n  max-width: 720px;\r\n}\r\n\r\n.two-col {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 18px;\r\n}\r\n\r\n.subcard {\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--radius-sm);\r\n  padding: 14px 16px;\r\n  background: rgba(19, 23, 38, 0.5);\r\n}\r\n\r\n.mini-heading {\n  font-family: var(--font-display);\n  font-size: 16px;\n  font-weight: 800;\n  text-transform: uppercase;\n  letter-spacing: 0;\n  color: var(--dim);\n  margin-bottom: 10px;\n}\n\r\n/* ---------- stat tiles ---------- */\r\n\r\n.tile-row {\r\n  display: grid;\r\n  gap: 10px;\r\n}\r\n\r\n.tile-row.three { grid-template-columns: repeat(3, 1fr); }\r\n.tile-row.four { grid-template-columns: repeat(4, 1fr); }\r\n.tile-row.five { grid-template-columns: repeat(5, 1fr); }\r\n.tile-row.six { grid-template-columns: repeat(6, 1fr); }\r\n.tile-row.wrap { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); }\r\n\r\n.stat-tile {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  padding: 12px 14px;\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--radius-sm);\r\n  background: var(--surface);\r\n  min-width: 0;\r\n}\r\n\r\n.stat-label {\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 0;\n  text-transform: uppercase;\n  color: var(--faint);\n}\n\r\n.stat-value {\r\n  font-family: var(--font-mono);\r\n  font-size: 19px;\r\n  font-weight: 700;\r\n  line-height: 1.2;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.stat-hint {\r\n  font-size: 11px;\r\n  color: var(--faint);\r\n}\r\n\r\n.stat-tile.tone-win .stat-value { color: var(--green); }\r\n.stat-tile.tone-loss .stat-value { color: var(--red); }\r\n.stat-tile.tone-warn .stat-value { color: var(--amber); }\r\n.stat-tile.tone-gold .stat-value { color: var(--accent-gold); }\r\n\r\n/* ---------- tags ---------- */\r\n\r\n.tag-row {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n  margin-top: 10px;\r\n}\r\n\r\n.tag {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  padding: 3px 10px;\r\n  border-radius: 99px;\r\n  font-size: 11.5px;\r\n  font-weight: 600;\r\n  line-height: 1.5;\r\n  border: 1px solid var(--line-strong);\r\n  background: var(--surface2);\r\n  color: var(--dim);\r\n}\r\n\r\n.tag.tone-win { color: var(--green); background: var(--green-soft); border-color: rgba(47, 213, 139, 0.3); }\r\n.tag.tone-loss { color: #ff8aa0; background: var(--red-soft); border-color: rgba(255, 51, 85, 0.32); }\r\n.tag.tone-warn { color: var(--amber); background: var(--amber-soft); border-color: rgba(251, 169, 76, 0.32); }\r\n.tag.tone-gold { color: var(--accent-gold); background: var(--gold-soft); border-color: rgba(245, 196, 81, 0.32); }\r\n.tag.tone-confidence { color: var(--accent-gold); background: var(--gold-soft); border-color: rgba(245, 196, 81, 0.32); }\r\n.tag.tone-conf-high, .tag.tone-conf-strong { color: var(--green); background: var(--green-soft); border-color: rgba(47, 213, 139, 0.3); }\r\n.tag.tone-conf-moderate { color: var(--accent-gold); background: var(--gold-soft); border-color: rgba(245, 196, 81, 0.32); }\r\n.tag.tone-conf-close { color: var(--amber); background: var(--amber-soft); border-color: rgba(251, 169, 76, 0.32); }\r\n\r\n/* ---------- buttons & inputs ---------- */\r\n\r\n.btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  padding: 9px 18px;\r\n  border-radius: var(--radius-sm);\r\n  border: 1px solid var(--line-strong);\r\n  background: var(--surface2);\r\n  color: var(--text);\r\n  font-family: var(--font-body);\r\n  font-size: 13.5px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease;\r\n  white-space: nowrap;\r\n}\r\n\r\n.btn:hover:not(:disabled) {\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.btn:disabled {\r\n  opacity: 0.45;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.btn-primary {\r\n  background: linear-gradient(135deg, #ff3355, #c81e3e);\r\n  border-color: rgba(255, 51, 85, 0.5);\r\n  box-shadow: 0 6px 24px rgba(255, 51, 85, 0.28);\r\n}\r\n\r\n.btn-primary:hover:not(:disabled) {\r\n  box-shadow: 0 8px 30px rgba(255, 51, 85, 0.4);\r\n}\r\n\r\n.btn-lg {\r\n  padding: 13px 30px;\r\n  border-radius: 12px;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.08em;\r\n  font-family: var(--font-display);\r\n  font-weight: 800;\r\n  font-size: 18px;\r\n}\r\n\r\n.btn-ghost {\r\n  background: transparent;\r\n}\r\n\r\n.btn-corner-red {\r\n  background: var(--red-soft);\r\n  border-color: rgba(255, 51, 85, 0.4);\r\n  color: #ff8aa0;\r\n}\r\n\r\n.btn-corner-blue {\r\n  background: var(--blue-soft);\r\n  border-color: rgba(61, 123, 255, 0.4);\r\n  color: #8fb4ff;\r\n}\r\n\r\n.chip {\r\n  padding: 5px 12px;\r\n  border-radius: 99px;\r\n  border: 1px solid var(--line-strong);\r\n  background: rgba(19, 23, 38, 0.7);\r\n  color: var(--dim);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  transition: color 0.12s ease, border-color 0.12s ease;\r\n}\r\n\r\n.chip:hover {\r\n  color: var(--text);\r\n  border-color: var(--red);\r\n}\r\n\r\n.select,\r\n.control input {\r\n  appearance: none;\r\n  padding: 9px 14px;\r\n  border-radius: var(--radius-sm);\r\n  border: 1px solid var(--line-strong);\r\n  background: var(--surface);\r\n  color: var(--text);\r\n  font-family: var(--font-body);\r\n  font-size: 13.5px;\r\n  font-weight: 600;\r\n  outline: none;\r\n}\r\n\r\n.select:focus,\r\n.control input:focus {\r\n  border-color: var(--red);\r\n}\r\n\r\n.select {\r\n  background-image: linear-gradient(45deg, transparent 50%, var(--dim) 50%),\r\n    linear-gradient(135deg, var(--dim) 50%, transparent 50%);\r\n  background-position: calc(100% - 18px) 55%, calc(100% - 13px) 55%;\r\n  background-size: 5px 5px;\r\n  background-repeat: no-repeat;\r\n  padding-right: 34px;\r\n}\r\n\r\n.link-button {\r\n  background: none;\r\n  border: none;\r\n  padding: 0;\r\n  color: var(--text);\r\n  font-family: var(--font-body);\r\n  font-size: 14.5px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  text-align: left;\r\n}\r\n\r\n.link-button:hover {\r\n  color: var(--accent-gold);\r\n  text-decoration: underline;\r\n}\r\n\r\n/* ---------- spinner / empty / error ---------- */\r\n\r\n.spinner-wrap {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 12px;\r\n  padding: 36px;\r\n  color: var(--dim);\r\n}\r\n\r\n.spinner {\r\n  width: 22px;\r\n  height: 22px;\r\n  border-radius: 50%;\r\n  border: 3px solid var(--surface2);\r\n  border-top-color: var(--red);\r\n  animation: spin 0.8s linear infinite;\r\n}\r\n\r\n@keyframes spin {\r\n  to { transform: rotate(360deg); }\r\n}\r\n\r\n.empty-state {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 44px 24px;\r\n  border: 1px dashed var(--line-strong);\r\n  border-radius: var(--radius);\r\n  text-align: center;\r\n  color: var(--dim);\r\n}\r\n\r\n.empty-icon {\r\n  font-size: 26px;\r\n  color: var(--faint);\r\n}\r\n\r\n.empty-state h3 {\r\n  font-family: var(--font-display);\r\n  font-size: 22px;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.04em;\r\n  color: var(--text);\r\n}\r\n\r\n.error-note {\r\n  padding: 12px 16px;\r\n  border: 1px solid rgba(255, 51, 85, 0.4);\r\n  border-radius: var(--radius);\r\n  background: var(--red-soft);\r\n  color: #ffb3c1;\r\n  font-size: 13px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n/* ---------- meters / split bar ---------- */\r\n\r\n.meter {\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.meter-head {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  font-size: 12.5px;\r\n  color: var(--dim);\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.meter-head strong {\r\n  font-family: var(--font-mono);\r\n  color: var(--text);\r\n}\r\n\r\n.meter-track {\r\n  height: 8px;\r\n  border-radius: 99px;\r\n  background: var(--surface2);\r\n  overflow: hidden;\r\n}\r\n\r\n.meter-fill {\r\n  height: 100%;\r\n  border-radius: 99px;\r\n  transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);\r\n}\r\n\r\n.meter-fill.tone-red { background: linear-gradient(90deg, #c81e3e, var(--red)); }\r\n.meter-fill.tone-blue { background: linear-gradient(90deg, #2456c4, var(--blue)); }\r\n.meter-fill.tone-gold { background: linear-gradient(90deg, #c79428, var(--accent-gold)); }\r\n.meter-fill.tone-violet { background: linear-gradient(90deg, #6354c9, var(--violet)); }\r\n\r\n.split-bar-wrap {\r\n  margin-top: 18px;\r\n}\r\n\r\n.split-bar {\r\n  position: relative;\r\n  display: flex;\r\n  height: 14px;\r\n  border-radius: 99px;\r\n  overflow: hidden;\r\n  background: var(--surface2);\r\n}\r\n\r\n.split-left {\r\n  background: linear-gradient(90deg, #a51635, var(--red));\r\n  transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1);\r\n}\r\n\r\n.split-right {\r\n  background: linear-gradient(90deg, var(--blue), #1d4dbd);\r\n  transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1);\r\n}\r\n\r\n.split-marker {\r\n  position: absolute;\r\n  top: -3px;\r\n  bottom: -3px;\r\n  width: 3px;\r\n  background: var(--text);\r\n  border-radius: 2px;\r\n  transform: translateX(-50%);\r\n  box-shadow: 0 0 10px rgba(255, 255, 255, 0.6);\r\n}\r\n\r\n.split-labels {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 14px;\r\n  margin-top: 8px;\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n}\r\n\r\n.corner-red { color: var(--red); }\r\n.corner-blue { color: #7ba4ff; }\r\n.corner-even { color: var(--dim); }\r\n\r\n/* ---------- avatars / fighter names ---------- */\r\n\r\n.avatar {\r\n  position: relative;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-shrink: 0;\r\n  border-radius: 50%;\r\n  overflow: hidden;\r\n  background: linear-gradient(\r\n    140deg,\r\n    hsl(var(--avatar-hue, 220), 38%, 26%),\r\n    hsl(var(--avatar-hue, 220), 45%, 14%)\r\n  );\r\n  border: 1.5px solid var(--line-strong);\r\n}\r\n\r\n.avatar img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  object-position: top;\r\n}\r\n\r\n.avatar-fallback {\r\n  display: none;\r\n  font-family: var(--font-display);\r\n  font-weight: 800;\r\n  color: var(--text);\r\n  letter-spacing: 0.04em;\r\n}\r\n\r\n.avatar[data-fallback=\"true\"] .avatar-fallback {\r\n  display: inline-flex;\r\n}\r\n\r\n.avatar.size-sm { width: 26px; height: 26px; font-size: 11px; }\r\n.avatar.size-lg { width: 40px; height: 40px; font-size: 15px; }\r\n.avatar.size-xl { width: 64px; height: 64px; font-size: 22px; }\r\n.avatar.size-hero { width: 124px; height: 124px; font-size: 42px; }\r\n\r\n.avatar.corner-red { border-color: rgba(255, 51, 85, 0.65); box-shadow: 0 0 18px rgba(255, 51, 85, 0.25); }\r\n.avatar.corner-blue { border-color: rgba(61, 123, 255, 0.65); box-shadow: 0 0 18px rgba(61, 123, 255, 0.25); }\r\n\r\n.fighter-name {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  color: inherit;\r\n  font: inherit;\r\n  font-weight: 700;\r\n}\r\n\r\n.fighter-name.clickable {\r\n  background: none;\r\n  border: none;\r\n  padding: 0;\r\n  cursor: pointer;\r\n}\r\n\r\n.fighter-name.clickable:hover .fighter-name-text {\r\n  color: var(--accent-gold);\r\n  text-decoration: underline;\r\n}\r\n\r\n.fighter-matchup {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.matchup-vs {\r\n  font-family: var(--font-display);\r\n  font-style: italic;\r\n  font-weight: 900;\r\n  font-size: 13px;\r\n  color: var(--faint);\r\n  text-transform: uppercase;\r\n}\r\n\r\n/* ---------- search input ---------- */\r\n\r\n.search-input {\r\n  position: relative;\r\n  width: 100%;\r\n}\r\n\r\n.search-input input {\r\n  width: 100%;\r\n  padding: 11px 15px;\r\n  border-radius: var(--radius-sm);\r\n  border: 1px solid var(--line-strong);\r\n  background: rgba(8, 10, 16, 0.85);\r\n  color: var(--text);\r\n  font-family: var(--font-body);\r\n  font-size: 14.5px;\r\n  font-weight: 600;\r\n  outline: none;\r\n  transition: border-color 0.15s ease, box-shadow 0.15s ease;\r\n}\r\n\r\n.search-input input:focus {\r\n  border-color: var(--accent-gold);\r\n}\r\n\r\n.search-input.corner-red input:focus {\r\n  border-color: var(--red);\r\n  box-shadow: 0 0 0 3px rgba(255, 51, 85, 0.18);\r\n}\r\n\r\n.search-input.corner-blue input:focus {\r\n  border-color: var(--blue);\r\n  box-shadow: 0 0 0 3px rgba(61, 123, 255, 0.18);\r\n}\r\n\r\n.search-results {\r\n  position: absolute;\r\n  top: calc(100% + 6px);\r\n  left: 0;\r\n  right: 0;\r\n  z-index: 40;\r\n  margin: 0;\r\n  padding: 6px;\r\n  list-style: none;\r\n  background: var(--surface2);\r\n  border: 1px solid var(--line-strong);\r\n  border-radius: var(--radius-sm);\r\n  box-shadow: var(--shadow);\r\n  max-height: 280px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.search-results button {\r\n  display: block;\r\n  width: 100%;\r\n  padding: 8px 12px;\r\n  border: none;\r\n  border-radius: 7px;\r\n  background: transparent;\r\n  color: var(--dim);\r\n  font-family: var(--font-body);\r\n  font-size: 13.5px;\r\n  font-weight: 600;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n\r\n.search-results button:hover,\r\n.search-results button.active {\r\n  background: var(--red-soft);\r\n  color: var(--text);\r\n}\r\n\r\n/* ---------- fight lab stage ---------- */\r\n\r\n.stage {\r\n  position: relative;\r\n  border-radius: 22px;\r\n  border: 1px solid var(--line);\r\n  overflow: hidden;\r\n  background:\r\n    radial-gradient(700px 320px at 18% 0%, rgba(255, 51, 85, 0.12), transparent 65%),\r\n    radial-gradient(700px 320px at 82% 0%, rgba(61, 123, 255, 0.13), transparent 65%),\r\n    linear-gradient(180deg, #0b0e17, #06070c);\r\n}\r\n\r\n.octagon-scene {\r\n  position: absolute;\r\n  inset: 0;\r\n}\r\n\r\n.octagon-scene canvas {\r\n  display: block;\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n\r\n.stage-overlay {\r\n  position: absolute;\r\n  inset: 0;\r\n  background: linear-gradient(180deg, rgba(5, 6, 10, 0.25) 0%, rgba(5, 6, 10, 0.66) 100%);\r\n  pointer-events: none;\r\n}\r\n\r\n.stage-content {\n  position: relative;\n  z-index: 2;\n  padding: 38px 38px 30px;\n  display: flex;\n  flex-direction: column;\r\n  gap: 26px;\n}\n\n.stage.stage-compact .stage-content {\n  padding: 24px 28px 22px;\n  gap: 18px;\n}\n\n.stage-head {\n  text-align: center;\n}\n\r\n.stage-title {\r\n  font-family: var(--font-display);\r\n  font-size: 64px;\r\n  font-weight: 900;\r\n  font-style: italic;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.02em;\r\n  line-height: 0.95;\r\n  background: linear-gradient(100deg, #fff 30%, #ffb3c1 65%, var(--red));\r\n  -webkit-background-clip: text;\r\n  background-clip: text;\r\n  color: transparent;\r\n  filter: drop-shadow(0 4px 28px rgba(255, 51, 85, 0.25));\n}\n\n.stage.stage-compact .stage-title {\n  font-size: 46px;\n}\n\n.stage-sub {\n  margin-top: 8px;\n  color: var(--dim);\n  font-size: 13.5px;\r\n  max-width: 520px;\r\n  margin-left: auto;\r\n  margin-right: auto;\n}\n\n.stage.stage-compact .stage-sub {\n  max-width: 720px;\n}\n\n.stage-form {\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  gap: 26px;\r\n  align-items: start;\n}\n\n.stage.stage-compact .stage-form {\n  gap: 18px;\n}\n\n.corner-panel {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\r\n  padding: 18px;\r\n  border-radius: var(--radius);\r\n  border: 1px solid var(--line);\r\n  background: rgba(8, 10, 16, 0.6);\r\n  backdrop-filter: blur(6px);\n}\n\n.stage.stage-compact .corner-panel {\n  padding: 14px;\n}\n\n.corner-panel.red { border-top: 2px solid var(--red); }\n.corner-panel.blue { border-top: 2px solid var(--blue); }\n\r\n.corner-head {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 14px;\r\n}\r\n\r\n.corner-tag {\r\n  font-family: var(--font-display);\r\n  font-weight: 800;\r\n  font-style: italic;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.14em;\r\n  font-size: 13px;\r\n}\r\n\r\n.stage-center {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 12px;\r\n  min-width: 220px;\r\n  padding-top: 4px;\r\n}\r\n\r\n.vs-mark {\r\n  font-family: var(--font-display);\r\n  font-style: italic;\r\n  font-weight: 900;\r\n  font-size: 40px;\r\n  line-height: 1;\r\n  background: linear-gradient(90deg, var(--red), #fff 50%, var(--blue));\r\n  -webkit-background-clip: text;\r\n  background-clip: text;\r\n  color: transparent;\r\n}\r\n\r\n.stage-tools {\r\n  display: flex;\r\n  gap: 8px;\r\n}\r\n\r\n.stage-examples {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  font-size: 12px;\r\n  color: var(--faint);\n}\n\n.matchup-strip {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 1px;\n  overflow: hidden;\n  border: 1px solid var(--line);\n  border-radius: var(--radius-sm);\n  background: var(--line);\n}\n\n.matchup-strip > div {\n  min-width: 0;\n  padding: 12px 14px;\n  background: rgba(8, 10, 16, 0.78);\n}\n\n.matchup-strip strong {\n  display: block;\n  margin-top: 2px;\n  color: var(--text);\n  font-family: var(--font-mono);\n  font-size: 14px;\n  overflow-wrap: anywhere;\n}\n\n.strip-label {\n  display: block;\n  font-size: 10px;\n  font-weight: 800;\n  text-transform: uppercase;\n  color: var(--faint);\n}\n\n.fight-lab.has-results .results-grid {\n  margin-top: 2px;\n}\n\n/* ---------- results ---------- */\n\r\n.results-grid {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 18px;\r\n}\r\n\r\n.results-grid > .card:nth-child(n + 3) {\r\n  grid-column: 1 / -1;\r\n}\r\n\r\n.verdict-card {\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n.verdict-card::before {\r\n  content: \"\";\r\n  position: absolute;\r\n  inset: 0;\r\n  background: radial-gradient(420px 200px at 18% 0%, var(--gold-soft), transparent 70%);\r\n  pointer-events: none;\r\n}\r\n\r\n.verdict-winner {\r\n  position: relative;\r\n}\r\n\r\n.verdict-name {\r\n  font-family: var(--font-display);\r\n  font-size: 34px;\r\n  font-weight: 900;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.02em;\r\n  margin: 6px 0 10px;\r\n}\r\n\r\n.verdict-confidence {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n}\r\n\r\n.big-number {\r\n  font-family: var(--font-mono);\r\n  font-size: 34px;\r\n  font-weight: 700;\r\n  color: var(--accent-gold);\r\n}\r\n\r\n/* ---------- insights ---------- */\r\n\r\n.insight-summary {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.insight-summary .tag {\r\n  width: fit-content;\r\n  white-space: normal;\r\n  line-height: 1.45;\r\n  padding: 7px 13px;\r\n  border-radius: 12px;\r\n}\r\n\r\n.insight-columns {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: 16px;\r\n}\r\n\r\n.insight-heading {\r\n  font-family: var(--font-display);\r\n  font-size: 16px;\r\n  font-weight: 800;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.06em;\r\n  margin-bottom: 10px;\r\n  padding-bottom: 7px;\r\n  border-bottom: 1px solid var(--line);\r\n}\r\n\r\n.insight-heading.support { color: var(--green); }\r\n.insight-heading.caution { color: var(--amber); }\r\n.insight-heading.path { color: #7ba4ff; }\r\n\r\n.insight-item